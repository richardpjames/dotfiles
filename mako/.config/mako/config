# ~/.config/mako/config

anchor=top-right
layer=overlay
width=360
height=110
margin=16
padding=14
border-size=2
border-radius=12
max-icon-size=48
icons=1
markup=1
actions=1
default-timeout=5000

font=JetBrainsMono Nerd Font 11

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

[urgency=low]
border-color=#74c7ec
default-timeout=3000

[urgency=normal]
border-color=#89b4fa
default-timeout=5000

[urgency=high]
border-color=#f38ba8
default-timeout=0
